<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the sealed session never leaves the phone, in cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aura_tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aura_tokens.xml" />
    </device-transfer>
</data-extraction-rules>
